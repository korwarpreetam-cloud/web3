// SPDX-License-Identifier: MIT
pragma solidity ^0.8.18;



contract SimpleBank{
    address public immutable owner;
    constructor(){
        owner = msg.sender;
     }

    event Deposited(address indexed user,uint256 amount);
    event withDrawn(address indexed user,uint256 amount);
    mapping (address=>uint256) public balances;


    function Deposite() public payable  {
        balances[msg.sender]+=msg.value;
        emit Deposited(msg.sender,msg.value);
     }

     function getBalance() public view returns(uint256){
        return balances[msg.sender];
     }

     function withdrawAmount(uint256 amountNeeded) public {
        require(balances[msg.sender]>=amountNeeded);
        balances[msg.sender]=balances[msg.sender]-amountNeeded; 

        //transfer
        (bool success, ) = payable(msg.sender).call{value: amountNeeded}("");
         require(success, "Transfer failed");
        emit withDrawn(msg.sender, amountNeeded);

     }

     modifier onlyOwner(){
        require(msg.sender==owner,"Not owner");
        _;
     }

     



}





