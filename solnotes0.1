       SimpleStorage newSimpleStorageContract = new SimpleStorage();
       listofSimpleStorage.push(newSimpleStorageContract);

    }

    function sfStorage (uint256 SimpleStorageIndex, uint256 newSimpleStorageNumber) public {
        //address 
        //abs
        SimpleStorage mySimpleStorage = SimpleStorage(listofSimpleStorage[SimpleStorageIndex]); // SimpleStorage(address)

        mySimpleStorage.store(newSimpleStorageNumber);
    }

    function sfGet (uint256 SimpleStorageIndex) public view returns(uint256){
        SimpleStorage mySimpleStorage = listofSimpleStorage[SimpleStorageIndex];
        return mySimpleStorage.retrieve();

    }
}





